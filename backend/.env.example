PORT=5000
NODE_ENV=development

# Supabase PostgreSQL Connection Strings
# Transaction connection pooler (port 6543) - Recommended for DATABASE_URL:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - Used for Prisma migrations and schema push (DIRECT_URL):
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# (Optional fallback for local offline development without Supabase)
# DATABASE_URL="file:./dev.db"

JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"
FRONTEND_URL="http://localhost:5173"
PLATFORM_COMMISSION_PERCENTAGE=5

RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
