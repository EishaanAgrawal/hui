datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}




generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  phone        String?
  passwordHash String
  role         String         @default("CONSUMER") // FARMER, CONSUMER, ADMIN
  avatar       String?
  isActive     Boolean        @default(true)
  isVerified   Boolean        @default(false)
  isBulkBuyer  Boolean        @default(false)
  companyName  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  farmerProfile FarmerProfile?
  addresses     Address[]
  orders        Order[]        @relation("CustomerOrders")
  cart          Cart?
  reviews       Review[]
  wishlist      Wishlist[]
  notifications Notification[]
  rfqs          Rfq[]
}

model FarmerProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName           String
  description        String?
  farmSize           String?        // e.g. "15 Acres"
  farmingType        String?        // e.g. "Organic", "Hydroponic", "Traditional", "Natural"
  experienceYears    Int?           @default(5)
  location           String         // e.g. "Nashik, Maharashtra" (Legacy/Display)
  addressLine1       String?        // Plot/Survey No
  addressLine2       String?        // Building/Landmark
  villageLocality    String?
  streetLane         String?
  talukaTehsil       String?
  city               String?
  district           String?
  state              String?
  pincode            String?
  country            String?        @default("India")
  landmark           String?
  googleMapsLink     String?
  locationAccuracy   String?        // VERIFIED, APPROXIMATE, NEEDS_ATTENTION
  latitude           Float?
  longitude          Float?
  verificationStatus String         @default("VERIFIED") // PENDING, VERIFIED, REJECTED, SUSPENDED
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  products           Product[]
  orderItems         OrderItem[]
  reviews            Review[]
  payouts            FarmerPayout[]
  rfqs               Rfq[]
  vehicles           Vehicle[]
  deliveryBatches    DeliveryBatch[]
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  addressLine1      String
  addressLine2      String?
  flatHouse         String?
  buildingApartment String?
  streetLane        String?
  localityArea      String?
  landmark          String?
  city              String
  district          String?
  state             String
  postalCode        String
  country           String?  @default("India")
  latitude          Float?
  longitude         Float?
  geocodingStatus   String?
  isDefault         Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  products    Product[]
}

model Product {
  id                   String         @id @default(uuid())
  farmerId             String
  farmer               FarmerProfile  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  categoryId           String
  category             Category       @relation(fields: [categoryId], references: [id])
  name                 String
  slug                 String
  description          String
  price                Float          // Farm price per unit (e.g. ₹40/kg)
  estimatedMarketPrice Float?         // Middleman/Retail market price for transparency comparison (e.g. ₹65/kg)
  unit                 String         @default("KG") // KG, GRAM, LITRE, PIECE, DOZEN, QUINTAL
  availableQuantity    Float          @default(0)
  minimumOrderQuantity Float          @default(1)
  bulkPricing          Json?          // Array of { minQty, maxQty, price }
  organic              Boolean        @default(false)
  harvestDate          DateTime?
  image                String?
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  images               ProductImage[]
  cartItems            CartItem[]
  orderItems           OrderItem[]
  reviews              Review[]
  wishlistItems        Wishlist[]
  rfqs                 Rfq[]
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String?
  sortOrder Int      @default(0)
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items     CartItem[]
}

model CartItem {
  id              String   @id @default(uuid())
  cartId          String
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity        Float    @default(1)
  priceAtAddition Float
  createdAt       DateTime @default(now())
}

model Order {
  id                      String       @id @default(uuid())
  orderNumber             String       @unique
  customerId              String
  customer                User         @relation("CustomerOrders", fields: [customerId], references: [id])
  subtotal                Float
  deliveryFee             Float        @default(0)
  platformFee             Float        @default(0)
  discount                Float        @default(0)
  total                   Float
  paymentStatus           String       @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  orderStatus             String       @default("CONFIRMED") // PENDING, CONFIRMED, ACCEPTED, PREPARING, READY_FOR_PICKUP, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, CANCELLED, REJECTED
  deliveryAddressSnapshot String       // JSON stringified address details
  notes                   String?
  batchId                 String?
  batch                   DeliveryBatch? @relation(fields: [batchId], references: [id])
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  items                   OrderItem[]
  payment                 Payment?
  delivery                Delivery?
  reviews                 Review[]
  payouts                 FarmerPayout[]
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product       @relation(fields: [productId], references: [id])
  farmerId    String
  farmer      FarmerProfile @relation(fields: [farmerId], references: [id])
  productName String
  unitPrice   Float
  quantity    Float
  unit        String        @default("KG")
  subtotal    Float
  status      String        @default("CONFIRMED") // CONFIRMED, ACCEPTED, PREPARING, READY, DELIVERED, CANCELLED
}

model Payment {
  id            String    @id @default(uuid())
  orderId       String    @unique
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String    @default("RAZORPAY") // RAZORPAY, CASH_ON_DELIVERY, UPI
  transactionId String?
  amount        Float
  currency      String    @default("INR")
  status        String    @default("SUCCESS") // PENDING, SUCCESS, FAILED, REFUNDED
  paidAt        DateTime? @default(now())
  createdAt     DateTime  @default(now())
}

model Delivery {
  id                String    @id @default(uuid())
  orderId           String    @unique
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner   String    @default("FarmDirect Express")
  trackingNumber    String
  status            String    @default("IN_TRANSIT") // PENDING, ASSIGNED, PICKED_UP, IN_TRANSIT, OUT_FOR_DELIVERY, DELIVERED, FAILED
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Review {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  farmerId  String
  farmer    FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?        @relation(fields: [orderId], references: [id])
  rating    Int           // 1 to 5
  comment   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("ORDER") // ORDER, PAYMENT, ACCOUNT, SYSTEM, PAYOUT
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FarmerPayout {
  id          String        @id @default(uuid())
  farmerId    String
  farmer      FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float         // Gross item sales
  platformFee Float         // Commission deducted (e.g. 5%)
  netAmount   Float         // Farmer actual earnings (amount - platformFee)
  status      String        @default("PAID") // PENDING, PROCESSED, PAID, FAILED
  paidAt      DateTime?     @default(now())
  createdAt   DateTime      @default(now())
}

model DeliveryRoute {
  id                String              @id @default(uuid())
  createdBy         String              // FarmerProfile ID
  startLocation     String              // Text description
  startLatitude     Float?
  startLongitude    Float?
  totalDistance     Float               // in km
  estimatedDuration Float               // in minutes
  status            String              @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED
  createdAt         DateTime            @default(now())
  
  stops             DeliveryRouteStop[]
}

model DeliveryRouteStop {
  id        String        @id @default(uuid())
  routeId   String
  route     DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId   String
  sequence  Int
  latitude  Float?
  longitude Float?
}

model Rfq {
  id               String        @id @default(uuid())
  buyerId          String
  buyer            User          @relation(fields: [buyerId], references: [id])
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  farmerId         String
  farmer           FarmerProfile @relation(fields: [farmerId], references: [id])
  requiredQuantity Float
  deliveryAddress  String
  preferredDate    DateTime?
  notes            String?
  status           String        @default("PENDING") // PENDING, QUOTED, ACCEPTED, REJECTED
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  
  quotation        Quotation?
}

model Quotation {
  id               String   @id @default(uuid())
  rfqId            String   @unique
  rfq              Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotedPrice      Float
  availableQuantity Float
  deliveryCost     Float    @default(0)
  validUntil       DateTime?
  notes            String?
  status           String   @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Vehicle {
  id               String        @id @default(uuid())
  farmerId         String
  farmer           FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name             String
  capacityKg       Float
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  batches          DeliveryBatch[]
}

model DeliveryBatch {
  id               String        @id @default(uuid())
  farmerId         String
  farmer           FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  vehicleId        String?
  vehicle          Vehicle?      @relation(fields: [vehicleId], references: [id])
  status           String        @default("CREATED") // CREATED, OPTIMIZED, OUT_FOR_DELIVERY, COMPLETED
  totalLoadKg      Float         @default(0)
  clusterName      String?       // Geographic grouping name e.g., "Mumbai West"
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orders           Order[]
}
