generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String
  role          String         @default("CONSUMER")
  avatar        String?
  isActive      Boolean        @default(true)
  isVerified    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  cart          Cart?
  farmerProfile FarmerProfile?
  notifications Notification[]
  orders        Order[]        @relation("CustomerOrders")
  reviews       Review[]
  wishlist      Wishlist[]
  driverProfile Driver?
}

model FarmerProfile {
  id                 String         @id @default(uuid())
  userId             String         @unique
  farmName           String
  description        String?
  farmSize           String?
  farmingType        String?
  experienceYears    Int?           @default(5)
  location           String
  addressLine1       String?
  addressLine2       String?
  villageLocality    String?
  streetLane         String?
  talukaTehsil       String?
  city               String?
  district           String?
  state              String?
  pincode            String?
  country            String?        @default("India")
  landmark           String?
  googleMapsLink     String?
  locationAccuracy   String?
  latitude           Float?
  longitude          Float?
  verificationStatus String         @default("VERIFIED")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  payouts            FarmerPayout[]
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  products           Product[]
  reviews            Review[]
}

model Address {
  id                String   @id @default(uuid())
  userId            String
  name              String
  phone             String
  addressLine1      String
  addressLine2      String?
  flatHouse         String?
  buildingApartment String?
  streetLane        String?
  localityArea      String?
  landmark          String?
  city              String
  district          String?
  state             String
  postalCode        String
  country           String?  @default("India")
  latitude          Float?
  longitude         Float?
  geocodingStatus   String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  formattedAddress  String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id                              String         @id @default(uuid())
  farmerId                        String
  categoryId                      String
  name                            String
  slug                            String
  description                     String
  price                           Float
  estimatedMarketPrice            Float?
  unit                            String         @default("KG")
  availableQuantity               Float          @default(0)
  minimumOrderQuantity            Float          @default(1)
  organic                         Boolean        @default(false)
  harvestDate                     DateTime?
  image                           String?
  isActive                        Boolean        @default(true)
  createdAt                       DateTime       @default(now())
  updatedAt                       DateTime       @updatedAt
  bulkMinimumQuantity             Float?
  bulkPrice                       Float?
  bulkPricingEnabled              Boolean        @default(false)
  freshMarketEnabled              Boolean        @default(true)
  reservedQuantity                Float          @default(0)
  soldQuantity                    Float          @default(0)
  isMarketPriceManuallyOverridden Boolean        @default(false)
  marketPriceFetchedAt            DateTime?
  marketPriceMarketName           String?
  marketPriceSource               String?
  cartItems                       CartItem[]
  orderItems                      OrderItem[]
  category                        Category       @relation(fields: [categoryId], references: [id])
  farmer                          FarmerProfile  @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  images                          ProductImage[]
  reviews                         Review[]
  wishlistItems                   Wishlist[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id              String   @id @default(uuid())
  cartId          String
  productId       String
  quantity        Float    @default(1)
  priceAtAddition Float
  createdAt       DateTime @default(now())
  purchaseType    String   @default("NORMAL")
  cart            Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id                      String         @id @default(uuid())
  orderNumber             String         @unique
  customerId              String
  subtotal                Float
  deliveryFee             Float          @default(0)
  platformFee             Float          @default(0)
  discount                Float          @default(0)
  total                   Float
  paymentStatus           String         @default("PENDING")
  orderStatus             String         @default("CONFIRMED")
  deliveryAddressSnapshot String
  notes                   String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  delivery                Delivery?
  payouts                 FarmerPayout[]
  customer                User           @relation("CustomerOrders", fields: [customerId], references: [id])
  items                   OrderItem[]
  payment                 Payment?
  reviews                 Review[]
  logisticsJob            LogisticsJob?
}

model OrderItem {
  id           String        @id @default(uuid())
  orderId      String
  productId    String
  farmerId     String
  productName  String
  unitPrice    Float
  quantity     Float
  unit         String        @default("KG")
  subtotal     Float
  status       String        @default("CONFIRMED")
  purchaseType String        @default("NORMAL")
  farmer       FarmerProfile @relation(fields: [farmerId], references: [id])
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id])
}

model Payment {
  id            String    @id @default(uuid())
  orderId       String    @unique
  provider      String    @default("RAZORPAY")
  transactionId String?
  amount        Float
  currency      String    @default("INR")
  status        String    @default("SUCCESS")
  paidAt        DateTime? @default(now())
  createdAt     DateTime  @default(now())
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Delivery {
  id                String    @id @default(uuid())
  orderId           String    @unique
  deliveryPartner   String    @default("FarmDirect Express")
  trackingNumber    String
  status            String    @default("IN_TRANSIT")
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String        @id @default(uuid())
  userId    String
  productId String
  farmerId  String
  orderId   String?
  rating    Int
  comment   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  farmer    FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  order     Order?        @relation(fields: [orderId], references: [id])
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("ORDER")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FarmerPayout {
  id          String        @id @default(uuid())
  farmerId    String
  orderId     String
  amount      Float
  platformFee Float
  netAmount   Float
  status      String        @default("PAID")
  paidAt      DateTime?     @default(now())
  createdAt   DateTime      @default(now())
  farmer      FarmerProfile @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model DeliveryRoute {
  id                String              @id @default(uuid())
  createdBy         String
  startLocation     String
  startLatitude     Float?
  startLongitude    Float?
  totalDistance     Float
  estimatedDuration Float
  status            String              @default("PLANNED")
  createdAt         DateTime            @default(now())
  stops             DeliveryRouteStop[]
}

model DeliveryRouteStop {
  id        String        @id @default(uuid())
  routeId   String
  orderId   String
  sequence  Int
  latitude  Float?
  longitude Float?
  route     DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------
// SMART LOGISTICS MODULE
// ----------------------------------------------------------------------

model Vehicle {
  id                 String           @id @default(uuid())
  registrationNumber String           @unique
  type               String           @default("MINI_TRUCK")
  maxWeightCapacity  Float
  maxVolumeCapacity  Float?
  currentLoad        Float            @default(0)
  status             String           @default("AVAILABLE") // AVAILABLE, ASSIGNED, ON_ROUTE, MAINTENANCE
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  drivers            Driver[]
  logisticsJobs      LogisticsJob[]
  routes             LogisticsRoute[]
}

model Driver {
  id               String           @id @default(uuid())
  userId           String           @unique
  assignedVehicleId String?
  status           String           @default("AVAILABLE") // AVAILABLE, ON_PICKUP, ON_DELIVERY, OFFLINE
  isVerified       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?         @relation(fields: [assignedVehicleId], references: [id])
  logisticsJobs    LogisticsJob[]
  routes           LogisticsRoute[]
}

model LogisticsJob {
  id                 String          @id @default(uuid())
  orderId            String          @unique
  status             String          @default("AWAITING_LOGISTICS") // AWAITING_LOGISTICS, PLANNING, PICKUP_SCHEDULED, EN_ROUTE_TO_PICKUP, IN_TRANSIT, DELIVERED, CANCELLED
  logisticsMode      String          @default("DIRECT") // DIRECT, CONSOLIDATED
  vehicleId          String?
  driverId           String?
  routeId            String?
  pickupLocation     String
  deliveryLocation   String
  expectedPickupTime DateTime?
  actualPickupTime   DateTime?
  expectedDeliveryTime DateTime?
  actualDeliveryTime DateTime?
  deliveryOtp        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?        @relation(fields: [vehicleId], references: [id])
  driver             Driver?         @relation(fields: [driverId], references: [id])
  route              LogisticsRoute? @relation(fields: [routeId], references: [id])
}

model LogisticsRoute {
  id                String               @id @default(uuid())
  vehicleId         String
  driverId          String
  totalDistance     Float
  estimatedDuration Float
  actualDuration    Float?
  status            String               @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  vehicle           Vehicle              @relation(fields: [vehicleId], references: [id])
  driver            Driver               @relation(fields: [driverId], references: [id])
  jobs              LogisticsJob[]
  stops             LogisticsRouteStop[]
}

model LogisticsRouteStop {
  id               String         @id @default(uuid())
  routeId          String
  sequence         Int
  stopType         String         @default("PICKUP") // PICKUP, DELIVERY
  location         String
  latitude         Float?
  longitude        Float?
  status           String         @default("PENDING") // PENDING, ARRIVED, COMPLETED
  expectedQuantity Float?
  actualQuantity   Float?
  estimatedArrival DateTime?
  actualArrival    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  route            LogisticsRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
}
